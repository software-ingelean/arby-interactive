# Copia este archivo a .env y agrega tu clave localmente.
GEMINI_API_KEY=
# Alternativa a GEMINI_API_KEY (no es necesario configurar ambas):
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Segundos por intento; aumentar no garantiza éxito y prolonga la espera.
ARBY_BOT_TIMEOUT=30

# Perfil Raspberry sin escritorio, con tira física de 82 LED.
# Prioridad: variables del proceso > .env > valores por defecto.
ARBY_EYES=none
ARBY_STRIP=true
ARBY_STRIP_GPIO=12
ARBY_STRIP_LEDS=82
ARBY_STRIP_BRIGHTNESS=20
ARBY_STRIP_EFFECT=solid

# Prueba offline: activa ambos; para el bot real, déjalos en false.
ARBY_DEMO=false
ARBY_MUTE=false

# Opciones adicionales; vacías conservan los valores predeterminados.
ARBY_MULTIPLEXING=
# regular-oe5 requiere recompilar rgbmatrix; consulta docs/MATRIZ_OE_GPIO5.md.
ARBY_MATRIX_MAPPING=regular
# Usa BGR si rojo y azul se muestran intercambiados (solo matrices).
ARBY_MATRIX_RGB_SEQUENCE=RGB
ARBY_ROW_ADDRESS_TYPE=
ARBY_MATRIX_BRIGHTNESS=
ARBY_SLOWDOWN=
ARBY_SWAP_EYES=false
ARBY_VOICE=es-MX-JorgeNeural
ARBY_RATE=+8%
ARBY_PITCH=+0Hz
ARBY_FFPLAY=
ARBY_AUDIO_DRIVER=
ARBY_AUDIO_DEVICE=
# Experimental: reinicializa el jack DESPUÉS de liberar la tira al cerrar.
# Requiere driver alsa y device plughw:CARD=Headphones,DEV=0.
ARBY_AUDIO_RECOVER_ON_EXIT=false

# Trill Craft en paralelo a la conversación; los toques usan frases automáticas.
# Configura zonas y sensibilidad en config/triki_config.json.
ARBY_TRILL=true

# Entrada: voice usa el micrófono; text conserva la consola.
# Instala las dependencias con: uv sync --extra voice
ARBY_INPUT_MODE=voice
# Índice PortAudio o nombre del dispositivo de ENTRADA (independiente de AUDIO_DEVICE).
ARBY_MIC_DEVICE=0
ARBY_MIC_CHANNEL=left
ARBY_MIC_LANGUAGE=es-CO
# Filtro: 0 < graves < agudos < 24000; ganancia entre -30 y 36 dB.
ARBY_MIC_GAIN_DB=6
ARBY_MIC_GRAVES=80
ARBY_MIC_AGUDOS=8000
# Bloques de 10, 20 o 40 ms; cola de 1 a 100 bloques.
ARBY_MIC_BLOCK_MS=20
ARBY_MIC_QUEUE_BLOCKS=8
# Threshold entre 0 y 1 (exclusivos); silencio 1–5000 ms; preroll 0–2000 ms.
ARBY_MIC_THRESHOLD=0.5
ARBY_MIC_SILENCE_MS=450
ARBY_MIC_PREROLL_MS=320
# Espera tras 'Arby' (0–120 s); timeout de red (0–120 s).
ARBY_MIC_FOLLOWUP_SECONDS=8
ARBY_MIC_REQUEST_TIMEOUT=10
# Máximo por segmento: 1–60 segundos.
ARBY_MIC_MAX_UTTERANCE_SECONDS=15
